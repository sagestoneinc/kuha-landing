# ─── Site ──────────────────────────────────────────────────────────────
# Public URL where this page is deployed (no trailing slash). Used for
# canonical/og:url and for the post-payment redirect.
NEXT_PUBLIC_SITE_URL=https://www.kuha.app

# Meta Pixel ID (optional). When set, the Pixel base code loads and the page
# fires ViewContent, InitiateCheckout, Lead and Purchase.
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Lemon Squeezy API ─────────────────────────────────────────────────
# Settings → API in the Lemon Squeezy dashboard. Keep this secret (server only).
LEMONSQUEEZY_API_KEY=
# Settings → Stores → the number next to your store name.
LEMONSQUEEZY_STORE_ID=
# Products → each plan's variant ID (number). Prices shown on the page are
# read from these variants, so the page always matches checkout.
LEMONSQUEEZY_VARIANT_VIP=
LEMONSQUEEZY_VARIANT_ELITE=
LEMONSQUEEZY_VARIANT_LUXXE=
# Set to "true" to create test-mode checkouts (no real charges).
LEMONSQUEEZY_TEST_MODE=false

# Settings → Webhooks → signing secret. Point the webhook at
#   https://<your-domain>/api/webhooks/lemonsqueezy
# and subscribe to order_created and order_refunded.
LEMONSQUEEZY_WEBHOOK_SECRET=

# ─── Fulfilment (optional) ─────────────────────────────────────────────
# Verified, paid orders are forwarded as JSON to this URL (e.g. your kuha.app
# backend) so it can upgrade the buyer's album. Signed with the secret below
# in the X-Kuha-Signature header (hex HMAC-SHA256 of the raw body).
FULFILLMENT_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_SECRET=

# ─── Promo ─────────────────────────────────────────────────────────────
# The discount code must exist in Lemon Squeezy (Store → Discounts) with the
# same percentage. After PROMO_ENDS_AT the page shows full prices and stops
# sending the code. Leave PROMO_CODE empty to turn the promo off.
PROMO_CODE=KUHAFIRST20
PROMO_PERCENT=20
PROMO_ENDS_AT=2026-10-31T23:59:59+08:00
PROMO_ENDS_LABEL=Oct 31
